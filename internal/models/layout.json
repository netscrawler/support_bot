{
  "version": 1,
  "page": {
    "format": "A4",
    "orientation": "portrait",
    "padding_mm": 16,
    "header": {
      "text": "Example report"
    },
    "footer": {
      "text": "Generated by support_bot"
    }
  },
  "blocks": [
    {
      "id": "daily-summary",
      "type": "metric",
      "dataset": "daily",
      "pos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 2
      },
      "metric": {
        "field": "accepted",
        "label": "Принято",
        "format": "number"
      }
    },
    {
      "id": "daily-chart",
      "type": "chart",
      "dataset": "daily",
      "pos": {
        "x": 3,
        "y": 0,
        "w": 9,
        "h": 4
      },
      "chart": {
        "kind": "line",
        "x_field": "date",
        "series": [
          {
            "field": "accepted",
            "title": "Принято"
          },
          {
            "field": "rejected",
            "title": "Отклонено"
          }
        ]
      }
    },
    {
      "id": "daily-table",
      "type": "table",
      "dataset": "daily",
      "pos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 0
      },
      "table": {
        "columns": [
          {
            "field": "date",
            "title": "Дата"
          },
          {
            "field": "accepted",
            "title": "Принято",
            "align": "right"
          },
          {
            "field": "rejected",
            "title": "Отклонено",
            "align": "right"
          }
        ],
        "limit": 20
      }
    },
    {
      "id": "summary-text",
      "type": "text",
      "pos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 0
      },
      "text": {
        "text": "{{ printf \"Всего строк: %d\" (len .daily) }}"
      }
    }
  ]
}
